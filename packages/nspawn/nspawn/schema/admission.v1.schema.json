{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nott.ing/schema/admission.v1",
  "title": "NOTT private launch and attempt admission v1",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "path": {"type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "optionalText": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "textList": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "pathList": {"type": "array", "items": {"$ref": "#/$defs/path"}, "uniqueItems": true},
    "Identity": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "Scope": {
      "type": "object", "additionalProperties": false,
      "required": ["read", "write", "audit", "permission_ceiling", "network", "administrative"],
      "properties": {
        "read": {"$ref": "#/$defs/pathList"}, "write": {"$ref": "#/$defs/pathList"},
        "audit": {"type": "boolean"}, "permission_ceiling": {"enum": ["read-only", "write"]},
        "network": {"$ref": "#/$defs/textList"}, "administrative": {"$ref": "#/$defs/pathList"}
      },
      "allOf": [{"if": {"properties": {"audit": {"const": true}}}, "then": {"properties": {"write": {"maxItems": 0}, "permission_ceiling": {"const": "read-only"}}}}]
    },
    "Runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["launcher", "node", "consumer", "sdk", "sdk_package", "native", "files"],
      "properties": {
        "launcher": {"$ref": "#/$defs/Identity"}, "node": {"$ref": "#/$defs/Identity"},
        "consumer": {"$ref": "#/$defs/Identity"}, "sdk": {"$ref": "#/$defs/Identity"},
        "native": {"$ref": "#/$defs/Identity"}, "sdk_package": {"$ref": "#/$defs/Identity"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Identity"}}
      }
    },
    "Constructor": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "effort", "permission_mode", "system_prompt", "tools", "skills", "setting_sources", "limits", "options"],
      "properties": {
        "model": {"$ref": "#/$defs/text"}, "effort": {"$ref": "#/$defs/text"},
        "permission_mode": {"$ref": "#/$defs/text"}, "system_prompt": {"type": ["string", "object"]},
        "tools": {"type": ["array", "object"]}, "skills": {"$ref": "#/$defs/textList"},
        "setting_sources": {"$ref": "#/$defs/textList"}, "limits": {"type": "object"}, "options": {"type": "object"}
      }
    },
    "Configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "format", "document", "digest", "role"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "format": {"enum": ["json", "toml", "text"]},
        "document": {"type": ["object", "string"]}, "digest": {"$ref": "#/$defs/digest"},
        "role": {"enum": ["user", "project", "parent", "managed", "plugin", "projection"]}
      }
    },
    "Project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "root", "plugin_parent", "plugin_view", "mcp_configuration"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "root": {"$ref": "#/$defs/path"},
        "plugin_parent": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}, "plugin_view": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "mcp_configuration": {"type": "object"}
      }
    },
    "LaunchInput": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command", "arguments", "inputs", "executables", "caller", "project", "grants", "destinations", "authorization"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "command": {"$ref": "#/$defs/path"},
        "arguments": {"type": "array", "items": {"type": "string"}}, "inputs": {"type": "object"},
        "executables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Identity"}},
        "caller": {"$ref": "#/$defs/text"}, "project": {"$ref": "#/$defs/text"},
        "grants": {"$ref": "#/$defs/Scope"}, "destinations": {"$ref": "#/$defs/pathList"},
        "authorization": {"$ref": "#/$defs/text"}
      }
    },
    "Policy": {
      "type": "object", "additionalProperties": false,
      "required": ["managed_sources", "trust_filter", "parent_settings", "helpers", "generation_digest", "refresh_ceiling"],
      "properties": {
        "managed_sources": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "trust_filter": {"type": "object"}, "parent_settings": {"$ref": "#/$defs/text"},
        "helpers": {"$ref": "#/$defs/textList"}, "generation_digest": {"$ref": "#/$defs/digest"},
        "refresh_ceiling": {"type": "object"}
      }
    },
    "Selection": {
      "type": "object", "additionalProperties": false, "required": ["sequence", "constructor_baseline"],
      "properties": {"sequence": {"$ref": "#/$defs/integer"}, "constructor_baseline": {"$ref": "#/$defs/digest"}}
    },
    "PendingControl": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "state", "receipt_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["input", "tool", "permission", "callback", "hook", "setting"]},
        "state": {"enum": ["consumed", "unsent", "suppressed", "cancelled", "unresolved"]},
        "receipt_ref": {"$ref": "#/$defs/optionalText"}
      }
    },
    "Conversation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "native_session", "frontier", "operation_index", "pending_control"],
      "properties": {
        "kind": {"enum": ["new", "interrupted", "synthetic"]},
        "native_session": {"$ref": "#/$defs/optionalText"}, "frontier": {"$ref": "#/$defs/optionalText"},
        "operation_index": {"$ref": "#/$defs/optionalText"},
        "pending_control": {"type": "array", "items": {"$ref": "#/$defs/PendingControl"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["interrupted", "synthetic"]}}}, "then": {"properties": {"native_session": {"$ref": "#/$defs/text"}, "frontier": {"$ref": "#/$defs/text"}, "operation_index": {"$ref": "#/$defs/text"}}}},
        {"if": {"properties": {"native_session": {"type": "null"}}}, "then": {"properties": {"frontier": {"type": "null"}, "operation_index": {"type": "null"}}}, "else": {"properties": {"frontier": {"$ref": "#/$defs/text"}, "operation_index": {"$ref": "#/$defs/text"}}}}
      ]
    },
    "PrelaunchProfileV1": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "node_id", "activation_id", "route_ref", "cwd", "scope", "runtime", "constructor", "configuration", "project", "mcp", "producer", "policy", "selection", "conversation", "stop_epoch"],
      "properties": {
        "version": {"const": 1}, "node_id": {"$ref": "#/$defs/text"}, "activation_id": {"$ref": "#/$defs/text"},
        "route_ref": {"$ref": "#/$defs/text"}, "cwd": {"$ref": "#/$defs/path"}, "scope": {"$ref": "#/$defs/Scope"},
        "runtime": {"$ref": "#/$defs/Runtime"}, "constructor": {"$ref": "#/$defs/Constructor"},
        "configuration": {"type": "array", "items": {"$ref": "#/$defs/Configuration"}}, "project": {"$ref": "#/$defs/Project"},
        "mcp": {"type": "array", "items": {"$ref": "#/$defs/LaunchInput"}}, "producer": {"type": "array", "items": {"$ref": "#/$defs/LaunchInput"}},
        "policy": {"$ref": "#/$defs/Policy"}, "selection": {"$ref": "#/$defs/Selection"},
        "conversation": {"$ref": "#/$defs/Conversation"}, "stop_epoch": {"$ref": "#/$defs/integer"}
      }
    },
    "AttemptKey": {
      "type": "object", "additionalProperties": false, "required": ["activation_id", "attempt_id", "owner_turn_id"],
      "properties": {"activation_id": {"$ref": "#/$defs/text"}, "attempt_id": {"$ref": "#/$defs/text"}, "owner_turn_id": {"$ref": "#/$defs/text"}}
    },
    "Input": {
      "type": "object", "additionalProperties": false, "required": ["id", "content"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "content": {"type": "array", "items": {"type": "object"}}}
    },
    "SessionAdmissionV1": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "key", "profile_digest", "profile", "conversation", "initial_input"],
      "properties": {
        "version": {"const": 1}, "key": {"$ref": "#/$defs/AttemptKey"}, "profile_digest": {"$ref": "#/$defs/digest"},
        "profile": {"$ref": "#/$defs/PrelaunchProfileV1"}, "conversation": {"$ref": "#/$defs/Conversation"},
        "initial_input": {"anyOf": [{"$ref": "#/$defs/Input"}, {"type": "null"}]}
      }
    },
    "AdmissionReceiptV1": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "key", "profile_digest", "admission_id", "revision", "state", "construction", "constructor_baseline", "frontier", "initial_input"],
      "properties": {
        "version": {"const": 1}, "key": {"$ref": "#/$defs/AttemptKey"}, "profile_digest": {"$ref": "#/$defs/digest"},
        "admission_id": {"$ref": "#/$defs/text"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "state": {"enum": ["admitted", "cancelled", "terminal"]}, "construction": {"const": "excluded"},
        "constructor_baseline": {"$ref": "#/$defs/digest"}, "frontier": {"$ref": "#/$defs/optionalText"},
        "initial_input": {"anyOf": [{"$ref": "#/$defs/Input"}, {"type": "null"}]}
      }
    },
    "AttemptReceiptV1": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "key", "profile_digest", "admission_id", "revision", "request_id", "state", "construction", "cancellation", "outcome", "control_ref", "native_session"],
      "properties": {
        "version": {"const": 1}, "key": {"$ref": "#/$defs/AttemptKey"}, "profile_digest": {"$ref": "#/$defs/digest"},
        "admission_id": {"$ref": "#/$defs/optionalText"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "request_id": {"type": ["integer", "string", "null"]},
        "state": {"enum": ["passive", "admitted", "constructed", "cancelled", "terminal"]},
        "construction": {"enum": ["excluded", "possible", "observed"]},
        "cancellation": {"enum": ["none", "before", "after", "unknown"]},
        "outcome": {"enum": [null, "completed", "error", "stopped", "refused", "limit", "unknown"]},
        "control_ref": {"$ref": "#/$defs/optionalText"}, "native_session": {"$ref": "#/$defs/optionalText"}
      },
      "allOf": [
        {"if": {"properties": {"construction": {"const": "observed"}}}, "then": {"properties": {"control_ref": {"$ref": "#/$defs/text"}}}},
        {"if": {"properties": {"construction": {"const": "excluded"}}}, "then": {"properties": {"control_ref": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "constructed"}}}, "then": {"properties": {"construction": {"const": "observed"}}}},
        {"if": {"properties": {"state": {"const": "terminal"}}}, "then": {"properties": {"outcome": {"type": "string"}}}, "else": {"properties": {"outcome": {"type": "null"}}}},
        {"if": {"properties": {"cancellation": {"const": "before"}}}, "then": {"properties": {"construction": {"const": "excluded"}}}}
      ]
    },
    "LaunchReceiptV1": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "activation_id", "route_ref", "profile_digest", "runtime_digest", "composition"],
      "properties": {
        "version": {"const": 1}, "activation_id": {"$ref": "#/$defs/text"}, "route_ref": {"$ref": "#/$defs/text"},
        "profile_digest": {"$ref": "#/$defs/digest"}, "runtime_digest": {"$ref": "#/$defs/digest"},
        "composition": {"type": "object", "required": ["scope", "runtime", "configuration", "project", "mcp", "producer", "policy"], "additionalProperties": false,
          "properties": {"scope": {"$ref": "#/$defs/Scope"}, "runtime": {"$ref": "#/$defs/Runtime"}, "configuration": {"type": "array", "items": {"$ref": "#/$defs/Configuration"}}, "project": {"$ref": "#/$defs/Project"}, "mcp": {"type": "array", "items": {"$ref": "#/$defs/LaunchInput"}}, "producer": {"type": "array", "items": {"$ref": "#/$defs/LaunchInput"}}, "policy": {"$ref": "#/$defs/Policy"}}
        }
      }
    },
    "AttemptRequestV1": {
      "type": "object", "additionalProperties": false, "required": ["version", "key", "profile_digest", "admission_id"],
      "properties": {"version": {"const": 1}, "key": {"$ref": "#/$defs/AttemptKey"}, "profile_digest": {"$ref": "#/$defs/digest"}, "admission_id": {"$ref": "#/$defs/optionalText"}}
    }
  }
}
