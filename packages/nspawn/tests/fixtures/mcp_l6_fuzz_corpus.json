{
  "version": 1,
  "note": "Adversarial `tools/call` arguments for the five nSPAWN replacement tools. Every entry must be answered by a typed JSON-RPC frame (result or error), never an untyped exception. Extend this file rather than replacing entries; a removed entry loses whatever regression it once proved.",
  "cases": [
    {"id": "execute-empty-object", "tool": "nspawn_run_start", "arguments": {}},
    {"id": "execute-null-arguments", "tool": "nspawn_run_start", "arguments": null},
    {"id": "execute-array-arguments", "tool": "nspawn_run_start", "arguments": [1, 2, 3]},
    {"id": "execute-string-arguments", "tool": "nspawn_run_start", "arguments": "not-an-object"},
    {"id": "execute-huge-prompt", "tool": "nspawn_run_start", "arguments": {"prompt": "P", "cwd": "/tmp"}},
    {"id": "execute-null-prompt", "tool": "nspawn_run_start", "arguments": {"prompt": null, "cwd": "/tmp"}},
    {"id": "execute-numeric-prompt", "tool": "nspawn_run_start", "arguments": {"prompt": 12345, "cwd": "/tmp"}},
    {"id": "execute-nested-cwd", "tool": "nspawn_run_start", "arguments": {"prompt": "hi", "cwd": {"nested": true}}},
    {"id": "execute-unknown-key", "tool": "nspawn_run_start", "arguments": {"prompt": "hi", "cwd": "/tmp", "vendor": "x"}},
    {"id": "execute-negative-timeout", "tool": "nspawn_run_start", "arguments": {"prompt": "hi", "cwd": "/tmp", "timeout_ms": -1}},
    {"id": "execute-bool-timeout", "tool": "nspawn_run_start", "arguments": {"prompt": "hi", "cwd": "/tmp", "timeout_ms": true}},
    {"id": "execute-control-chars", "tool": "nspawn_run_start", "arguments": {"prompt": "hi \u001b[31m end", "cwd": "/tmp"}},
    {"id": "execute-unicode-surrogate-ish", "tool": "nspawn_run_start", "arguments": {"prompt": "😀​‍", "cwd": "/tmp"}},
    {"id": "execute-empty-strings", "tool": "nspawn_run_start", "arguments": {"prompt": "", "cwd": ""}},
    {"id": "execute-class-empty", "tool": "nspawn_run_start", "arguments": {"prompt": "hi", "cwd": "/tmp", "class": ""}},
    {"id": "execute-sql-injection-like", "tool": "nspawn_run_start", "arguments": {"prompt": "'; DROP TABLE runs; --", "cwd": "/tmp"}},
    {"id": "execute-path-traversal-cwd", "tool": "nspawn_run_start", "arguments": {"prompt": "hi", "cwd": "../../../../etc/passwd"}},
    {"id": "review-missing-both-required", "tool": "nspawn_review_start", "arguments": {}},
    {"id": "review-array-instead-of-object", "tool": "nspawn_review_start", "arguments": ["feat/x"]},
    {"id": "status-missing-run-id", "tool": "nspawn_run_show", "arguments": {}},
    {"id": "status-numeric-run-id", "tool": "nspawn_run_show", "arguments": {"run_id": 42}},
    {"id": "status-negative-timeout", "tool": "nspawn_run_show", "arguments": {"run_id": "r1", "timeout_ms": -5}},
    {"id": "status-huge-timeout", "tool": "nspawn_run_show", "arguments": {"run_id": "r1", "timeout_ms": 999999999}},
    {"id": "status-float-timeout", "tool": "nspawn_run_show", "arguments": {"run_id": "r1", "timeout_ms": 1.5}},
    {"id": "transcript-negative-since-seq", "tool": "nspawn_transcript_show", "arguments": {"run_id": "r1", "since_seq": -1}},
    {"id": "transcript-zero-max-bytes", "tool": "nspawn_transcript_show", "arguments": {"run_id": "r1", "max_bytes": 0}},
    {"id": "transcript-null-run-id", "tool": "nspawn_transcript_show", "arguments": {"run_id": null}},
    {"id": "close-deeply-nested-run-id", "tool": "nspawn_run_close", "arguments": {"run_id": {"a": {"b": {"c": 1}}}}},
    {"id": "close-many-unknown-keys", "tool": "nspawn_run_close", "arguments": {"run_id": "r1", "k0": 0, "k1": 1, "k2": 2, "k3": 3, "k4": 4}},
    {"id": "close-list-run-id", "tool": "nspawn_run_close", "arguments": {"run_id": ["r1"]}}
  ]
}
